# =========================================================
# SecondSelf - Git Ignore
# =========================================================

# -------------------------
# Environment & Secrets
# -------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# -------------------------
# Python Virtual Environment
# -------------------------
backend/venv/
venv/
.venv/
env/
ENV/

# -------------------------
# Python Cache / Bytecode
# -------------------------
__pycache__/
*.py[cod]
*$py.class

# -------------------------
# Python Build Artifacts
# -------------------------
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/

*.egg-info/
.installed.cfg
*.egg
MANIFEST

# -------------------------
# Node.js Dependencies
# -------------------------
node_modules/
frontend/node_modules/

# -------------------------
# Frontend Build Output
# -------------------------
frontend/dist/
frontend/dist-ssr/

# Vite local environment files
frontend/*.local

# -------------------------
# Electron Build Output
# -------------------------
dist-electron/

# -------------------------
# Local Databases
# -------------------------
*.db
*.sqlite
*.sqlite3

# Keep the data folder itself in Git
# but ignore generated/local database files
data/*
!data/.gitkeep

# -------------------------
# Logs
# -------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Coverage / Testing
# -------------------------
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover

# -------------------------
# TypeScript / Tool Caches
# -------------------------
*.tsbuildinfo

# -------------------------
# VS Code / IDE
# -------------------------
.vscode/
.idea/
*.iml

# Editor temporary files
*.swp
*.swo
*.swn
*.sublime-workspace
*.sublime-project

# -------------------------
# OS Generated Files
# -------------------------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# -------------------------
# Temporary Files
# -------------------------
*.tmp
*.temp
*.bak
*.backup
*.old
*~

# -------------------------
# Playwright
# -------------------------
playwright-report/
test-results/
blob-report/

# -------------------------
# Electron / Chromium Temporary Files
# -------------------------
*.crash